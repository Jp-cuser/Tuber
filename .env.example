# Server-only settings. Never prefix secrets with NEXT_PUBLIC_.
ACCESS_MODE=disabled
ACCESS_TOKEN=
DEMO_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=info

# AI provider settings (server-only). Configure only the providers you use.
AI_REQUEST_TIMEOUT_MS=60000
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_API_KEY also enables server-side Whisper transcription.
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_GOOGLE_API_KEY=
AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
AI_AZURE_API_KEY=
AI_AZURE_BASE_URL=
AI_AZURE_DEPLOYMENT=
AI_AZURE_API_VERSION=
AI_XAI_API_KEY=
AI_GROQ_API_KEY=
AI_COHERE_API_KEY=
AI_MISTRALAI_API_KEY=
AI_PERPLEXITY_API_KEY=
AI_FIREWORKS_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_OPENROUTER_API_KEY=
AI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_DIFY_API_KEY=
AI_DIFY_BASE_URL=

# Optional Custom API mapping
AI_CUSTOM_API_URL=
AI_CUSTOM_API_ALLOWED_ORIGINS=
AI_CUSTOM_API_HEADERS=
AI_CUSTOM_API_BODY_TEMPLATE=
AI_CUSTOM_API_RESPONSE_TEXT_PATH=text

# Public, non-secret UI defaults
NEXT_PUBLIC_DEFAULT_LANGUAGE=ja
NEXT_PUBLIC_DEFAULT_THEME=default
NEXT_PUBLIC_SETTINGS_ENV_OVERRIDE=false
